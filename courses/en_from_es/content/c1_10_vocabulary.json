  {
   "type": "exercises",
   "items": [
    {
     "q": "There is no ______ that the drug works.",
     "hint": "pruebas",
     "a": "evidence",
     "full": "There is no evidence that the drug works."
    },
    {
     "q": "We need a new ______ to the problem.",
     "hint": "enfoque",
     "a": "approach",
     "full": "We need a new approach to the problem."
    },
    {
     "q": "The report ______ the need for more funding.",
     "hint": "subraya",
     "a": "highlights",
     "full": "The report highlights the need for more funding."
    },
    {
     "q": "The government must ______ unemployment.",
     "hint": "abordar",
     "a": "tackle",
     "full": "The government must tackle unemployment."
    },
    {
     "q": "Social media has had a huge ______ on politics.",
     "hint": "impacto",
     "a": "impact",
     "full": "Social media has had a huge impact on politics."
    },
    {
     "q": "She was very ______ when I told her about my problems.",
     "hint": "comprensiva",
     "a": "sympathetic",
     "full": "She was very sympathetic when I told her about my problems."
    },
    {
     "q": "I didn't ______ how late it was.",
     "hint": "darse cuenta",
     "a": "realise",
     "full": "I didn't realise how late it was."
    },
    {
     "q": "He ______ that he had made a mistake.",
     "hint": "reconocer, past",
     "a": "acknowledged",
     "full": "He acknowledged that he had made a mistake."
    },
