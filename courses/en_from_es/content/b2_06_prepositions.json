    7.6
   ],
   "head": [
    "Palabra",
    "Significado",
    "Ejemplo"
   ],
   "rows": [
    [
     "by",
     "como muy tarde, no más tarde de",
     "Please reply by Friday."
    ],
    [
     "until / till",
     "hasta (algo dura hasta ese momento)",
     "I'll wait until six."
    ],
    [
     "for",
     "cuánto tiempo (un periodo)",
     "I lived there for five years."
    ],
    [
     "during",
     "cuándo (dentro de un periodo)",
     "I fell asleep during the film."
    ],
    [
     "since",
     "desde (un punto de partida)",
     "I've been here since Monday."
    ]
   ]
  },
  {
   "type": "callout",
   "kind": "warn",
   "title": "hasta = by o until; durante = for o during",
   "text": "<i>Entrégalo hasta el viernes</i> es ambiguo. Si es una fecha límite, di <b>by Friday</b>. Si algo dura hasta el viernes, di <b>until Friday</b>: <i>The shop is closed until Friday.</i> Y <i>durante</i> puede ser <b>for</b> (cuánto tiempo: <i>for two hours</i>) o <b>during</b> (en qué momento: <i>during the film</i>), nunca <i>during two hours</i>."
  },
