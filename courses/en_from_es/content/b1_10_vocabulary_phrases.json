  {
   "type": "callout",
   "kind": "dutch",
   "title": "Falsos amigos",
   "bullets": [
    "<b>eventually</b> = al final, finalmente, no <i>eventualmente</i> (eso es <b>possibly</b>).",
    "<b>actually</b> = en realidad, no <i>actualmente</i> (eso es <b>currently</b> o <b>nowadays</b>).",
    "<b>lecture</b> = clase, conferencia, no <i>lectura</i> (eso es <b>reading</b>); <b>library</b> = biblioteca, no <i>librería</i> (eso es <b>bookshop</b>).",
    "<b>embarrassed</b> = avergonzado, no <i>embarazada</i> (eso es <b>pregnant</b>)."
   ]
  },
