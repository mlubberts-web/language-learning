 {"type": "h1", "text": "5. Winkelen en de weg vragen"},
 {"type": "verbpairs", "title": "Winkelen", "items": [
  ["How much is it?", "Hoeveel kost het?"], ["It's too expensive.", "Het is te duur."],
  ["Can I pay by card?", "Kan ik pinnen?"], ["I'm just looking.", "Ik kijk alleen even."],
  ["Have you got this in a smaller size?", "Heeft u dit in een kleinere maat?"], ["a receipt", "een bonnetje"]]},
 {"type": "verbpairs", "title": "De weg vragen", "items": [
  ["Excuse me, where is the station?", "Pardon, waar is het station?"], ["Go straight on.", "Ga rechtdoor."],
