 {"type": "h1", "text": "1. Groeten en beleefdheid"},
 {"type": "verbpairs", "title": "Groeten", "items": [
  ["Hello. / Hi.", "Hallo."], ["Good morning.", "Goedemorgen."], ["Good afternoon.", "Goedemiddag."],
  ["Good evening.", "Goedenavond."], ["Goodbye. / Bye.", "Tot ziens. / Doei."], ["See you later.", "Tot straks."],
  ["Nice to meet you.", "Leuk je te ontmoeten."], ["How are you?", "Hoe gaat het?"],
  ["I'm fine, thanks.", "Goed, dank je."], ["Good night.", "Welterusten."]]},
 {"type": "verbpairs", "title": "Beleefdheid", "items": [
  ["please", "alsjeblieft (bij een verzoek)"], ["thank you", "dank je"], ["You're welcome.", "Graag gedaan."],
  ["Sorry.", "Sorry."], ["Excuse me.", "Pardon. (om iets te vragen)"], ["Pardon?", "Wat zei je?"],
  ["Here you are.", "Alsjeblieft. (bij het geven)"], ["No problem.", "Geen probleem."]]},
 {"type": "callout", "kind": "dutch", "title": "alsjeblieft = please of here you are", "text": "Het Nederlandse <i>alsjeblieft</i> heeft twee betekenissen. Bij een verzoek zeg je <b>please</b>: <i>A coffee, please.</i> Als je iets geeft, zeg je <b>here you are</b> (of <b>there you go</b>), nooit <i>please</i>."},

 {"type": "h1", "text": "2. Familie"},
