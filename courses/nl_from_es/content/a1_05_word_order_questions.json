    "Regla",
    "Ejemplo",
    "Español"
   ],
   "rows": [
    [
     "al final, tras el verbo y el complemento",
     "Ik zie hem niet.",
     "No lo veo."
    ],
    [
     "delante de un adjetivo",
     "Het is niet duur.",
     "No es caro."
    ],
    [
     "delante de un complemento con preposición",
     "Ik ga niet naar huis.",
     "No me voy a casa."
    ],
    [
