     "inversión",
     "Morgen haast ik me niet.",
     "Mañana no me doy prisa."
    ],
    [
     "pregunta",
     "Herinner je je die dag?",
     "¿Te acuerdas de aquel día?"
    ],
    [
     "subordinada",
     "omdat hij zich verveelt",
     "porque se aburre"
    ],
    [
     "verbo separable",
     "Ik kleed me aan.",
     "Me visto."
    ],
