    "Regla",
    "Ejemplo",
    "Más ejemplos"
   ],
   "rows": [
    [
     "vocal larga: una letra",
     "groot → grote",
     "laag → lage, duur → dure"
    ],
    [
     "vocal corta: consonante doble",
     "dik → dikke",
     "wit → witte, snel → snelle"
    ],
    [
     "la f se convierte en v",
     "lief → lieve",
     "doof → dove"
    ],
    [
     "la s se convierte en z",
     "grijs → grijze",
     "boos → boze, pero: vies → vieze"
    ],
    [
     "sin -e: adjetivos en -en",
     "open, gesloten",
     "de open deur, de gouden ring"
    ],
    [
     "sin -e: materiales en -en",
     "houten, wollen",
     "de houten tafel"
    ]
   ]
